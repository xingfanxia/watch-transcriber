# Required: Gemini API key for transcription
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: delivery targets (comma-separated)
# Available: file, local_archive, apple_notes, feishu, feishu_notify, obsidian_git, agent
DELIVERY_TARGETS=file,apple_notes

# Optional: for obsidian_git delivery
OBSIDIAN_REPO=username/obsidian-vault
GITHUB_TOKEN=ghp_xxxxx

# Optional: for agent delivery (claude -p)
# The agent command to run for delivery. {title} and {content} are replaced.
# Examples:
#   claude -p "use lark-doc skill to create a feishu doc titled '{title}' with content: {content}"
#   claude -p "use gws-docs skill to create a google doc titled '{title}' with content: {content}"
AGENT_DELIVERY_PROMPT=use lark-doc skill to create a feishu doc titled '{title}' with this content:\n{content}

# Optional: for feishu delivery (lark-cli)
# FEISHU_FOLDER_TOKEN=fldcnXXXXXX
# FEISHU_WIKI_SPACE=my_library
# FEISHU_NOTIFY_USER_ID=ou_xxxxx  # get from: lark-cli auth status

# Optional: output directory for file delivery
OUTPUT_DIR=~/Documents/VoiceNotes

# Optional: structured local archive (data/YYYY-MM-DD/ with per-recording .md + daily.md + daily.html)
LOCAL_ARCHIVE_DIR=./data
LOCAL_ARCHIVE_HTML=1   # set to 0 to skip HTML rollup

# Optional: Apple Notes folder name
APPLE_NOTES_FOLDER=Voice Transcripts
