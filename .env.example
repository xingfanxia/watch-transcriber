# Required: Gemini API key. Used for the SUMMARY stage regardless of STT provider,
# and for transcription when STT_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (summary stage + gemini transcription).
GEMINI_MODEL=gemini-3.5-flash

# STT provider: lark (default) | gemini | openai
#   lark   → 妙记 (Volcano Lark Minutes ASR). Best diarization, single server-side
#            call. REQUIRES the VOLC_* credentials below (+ `pip install tos`).
#   gemini → Gemini chunked transcription + Senko/pyannote diarization (no VOLC needed).
#   openai → gpt-4o-transcribe-diarize; slower, weaker on zh+en code-switching.
STT_PROVIDER=lark

# Required when STT_PROVIDER=lark — 妙记 API key + Volcano TOS (hosts audio for
# 妙记 to fetch via presigned URL). See volc_lark.py.
VOLC_API_KEY=your_volc_api_key
VOLC_TOS_ACCESS_KEY=your_tos_access_key
VOLC_TOS_SECRET_KEY=your_tos_secret_key
VOLC_TOS_BUCKET=your_bucket
# Tip: a Hong Kong region uploads MUCH faster from outside mainland China
# (~700KB/s single-stream vs ~10-30KB/s to Shanghai) and 妙记 can still fetch it.
VOLC_TOS_REGION=cn-hongkong
VOLC_TOS_ENDPOINT=tos-cn-hongkong.volces.com
# LARK_MP3_BITRATE=32k     # lower (e.g. 16k) = faster cross-border upload
# LARK_NUM_SPEAKERS=0      # 0 = auto-detect speaker count

# OPENAI_API_KEY=sk-...    # only required when STT_PROVIDER=openai

# Skip recordings shorter than this many seconds (default 60).
# Voice Memos sometimes captures sub-second accidental taps; transcribing them
# wastes API quota. Set 0 to disable filter.
MIN_DURATION_SECONDS=60

# Long-audio chunking (silence-aware, parallel). Defaults are good for typical
# meetings — only tune if you have unusual audio (very fast speech, lots of
# silence, very long monologues).
# CHUNK_THRESHOLD_SEC=1080      # only chunk if audio > this many sec (18min)
# CHUNK_TARGET_SEC=720          # aim for chunks of this length (12min)
# CHUNK_MIN_SEC=480             # min chunk size when picking silence boundary
# CHUNK_MAX_SEC=900             # max chunk size when picking silence boundary
# CHUNK_PARALLELISM=8           # concurrent API calls per file
# CHUNK_OVERLAP_SEC=60          # adjacent-chunk overlap for speaker reconciliation

# Global speaker diarization. Both options run a single specialized model pass on
# the FULL audio (no chunk-overlap reconciliation hack), giving consistent
# SPEAKER_X labels across the whole transcript.
#   auto (default) → senko if installed → else pyannote (if HUGGINGFACE_TOKEN set) → else none
#   senko          → CoreML-native on Apple Silicon, ~50x faster than pyannote.
#                    Requires `pip install senko`. No token needed.
#   pyannote       → pyannote.audio + HuggingFace gated models. Slow on MPS
#                    (~15-25 min for 2hr on M-series). Requires HUGGINGFACE_TOKEN
#                    + accepting licenses for 3 pyannote/* models on HF.
#   none           → no global diarization; rely on chunk-overlap text matching only.
DIARIZER=auto
# HUGGINGFACE_TOKEN=hf_...    # only required for pyannote fallback

# Optional: delivery targets (comma-separated)
# Available: file, local_archive, apple_notes, feishu, feishu_notify, obsidian_git, agent
DELIVERY_TARGETS=file,apple_notes

# Optional: for obsidian_git delivery
OBSIDIAN_REPO=username/obsidian-vault
GITHUB_TOKEN=ghp_xxxxx

# Optional: for agent delivery (claude -p)
# The agent command to run for delivery. {title} and {content} are replaced.
# Examples:
#   claude -p "use lark-doc skill to create a feishu doc titled '{title}' with content: {content}"
#   claude -p "use gws-docs skill to create a google doc titled '{title}' with content: {content}"
AGENT_DELIVERY_PROMPT=use lark-doc skill to create a feishu doc titled '{title}' with this content:\n{content}

# Optional: for feishu delivery (lark-cli)
# FEISHU_FOLDER_TOKEN=fldcnXXXXXX
# FEISHU_WIKI_SPACE=my_library
# FEISHU_NOTIFY_USER_ID=ou_xxxxx  # get from: lark-cli auth status

# Optional: output directory for file delivery
OUTPUT_DIR=~/Documents/VoiceNotes

# Optional: structured local archive (data/YYYY-MM-DD/ with per-recording .md + daily.md + daily.html)
LOCAL_ARCHIVE_DIR=./data
LOCAL_ARCHIVE_HTML=1   # set to 0 to skip HTML rollup

# Optional: Apple Notes folder name
APPLE_NOTES_FOLDER=Voice Transcripts
